{
  "name": "dsh-chat-sessions",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "check": "node check.mjs",
    "test": "node --test check-create.mjs check-archive.mjs check-header.mjs check-gc.mjs check-lifecycle-store.mjs check-lifecycle.mjs check-lifecycle-legacy.mjs",
    "test:native": "node --test check-archive-native.mjs",
    "test:lifecycle": "node --test check-lifecycle.mjs",
    "test:lifecycle:native": "node --test check-lifecycle-native.mjs",
    "test:lifecycle:e2e": "node --test check-lifecycle-e2e.mjs",
    "verify": "npm run check && npm test"
  },
  "description": "Standalone chats without choosing a project workspace first: the plugin maintains native workspaces in the background, a new room gets a working directory, and derived sessions may share it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "session"
  ],
  "license": "MIT",
  "author": "zsqbfan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsqbfan/dsh-chat-sessions.git"
  },
  "homepage": "https://github.com/zsqbfan/dsh-chat-sessions#readme",
  "bugs": {
    "url": "https://github.com/zsqbfan/dsh-chat-sessions/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./links": "./links.js",
    "./gc": "./gc.js",
    "./lifecycle/model": "./lifecycle/model.js",
    "./lifecycle/store": "./lifecycle/store.js"
  },
  "files": [
    "index.js",
    "client.js",
    "links.js",
    "gc.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.en.md",
    "docs/CONFIGURATION.md",
    "docs/CONFIGURATION.en.md",
    "CHANGELOG.md",
    "lifecycle/*.js",
    "check-lifecycle.mjs",
    "check-lifecycle-store.mjs",
    "check-lifecycle-legacy.mjs",
    "check-lifecycle-native.mjs",
    "check-lifecycle-e2e.mjs",
    "test-support/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
